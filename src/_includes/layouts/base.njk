{% set assetHash = global.random() %}
<!DOCTYPE html>
<html>
	<head>
    {% include "partials/global/meta.njk" %}
		<link rel="shortcut icon" href="/favicon.ico" />
		<link href='/assets/css/main.css?{{ assetHash }}' rel='stylesheet' type='text/css'>
	</head>
	<body>
    <a href="#main-content" class="c-skip-to-content">Skip to the content</a>
    {% include "partials/global/header.njk" %}
    <main id="main-content" class="o-main-content">
      {% block content %}
      {% endblock %}
    </main>
    {%if page.fileSlug != '' %}

      {% include "partials/global/footer.njk" %}

    {% endif %}

    <script type="text/javascript" src="/assets/scripts/common.js?{{ assetHash }}"></script>
  </body>
</html>
